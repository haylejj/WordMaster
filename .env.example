# =============================================================================
# WordMaster Environment Variables
# =============================================================================
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# .env dosyası Git'e COMMIT EDİLMEMELİDİR!
# 
# .NET format: Hiyerarşi için __ (çift alt çizgi) kullanılır
# Örnek: Jwt__Key = appsettings.json'daki Jwt:Key
# =============================================================================

# -----------------------------------------------------------------------------
# CONNECTION STRINGS
# -----------------------------------------------------------------------------
# Local Development
ConnectionStrings__SqlServer=Server=localhost;Database=DB_WordMaster_API_Dev;Trusted_Connection=True;TrustServerCertificate=True;
ConnectionStrings__Redis=localhost:6379

# Docker (docker-compose.yml bu değişkenleri kullanır)
DOCKER_DB_CONNECTION_STRING=Server=db;Database=DB_WordMaster_API_Dev;User Id=USER;Password=YourStrongPassword!;Trusted_Connection=False;TrustServerCertificate=True;
DOCKER_REDIS_CONNECTION_STRING=redis:6379
DB_PASSWORD=YourStrongPassword!

# -----------------------------------------------------------------------------
# ENVIRONMENT
# -----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
Jwt__Key=YourSuperSecretKeyAtLeast32Characters!
Jwt__Issuer=WordMasterApi
Jwt__Audience=WordMasterClient
Jwt__ExpiresInMinutes=60
Jwt__RefreshTokenExpiresInDays=7

# -----------------------------------------------------------------------------
# GOOGLE OAUTH
# -----------------------------------------------------------------------------
Authentication__Google__ClientId=your-google-client-id.apps.googleusercontent.com
Authentication__Google__ClientSecret=your-google-client-secret

# -----------------------------------------------------------------------------
# EMAIL SETTINGS
# -----------------------------------------------------------------------------
EmailSettings__Host=smtp.gmail.com
EmailSettings__Password=your-app-password
EmailSettings__Email=your-email@gmail.com

# -----------------------------------------------------------------------------
# MAILHOG (Development)
# -----------------------------------------------------------------------------
MailHog__Host=localhost
MailHog__Port=1025
MailHog__EnableSsl=false
MailHog__FromEmail=dev@localhost

# -----------------------------------------------------------------------------
# URLS
# -----------------------------------------------------------------------------
URLs__Client=http://localhost:5173
URLs__Api=http://localhost:3002
