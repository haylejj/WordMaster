@using WordMaster.Application.ViewModels.Auth
@model ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Şifre Yenileme";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    <div class="text-center mt-3">
        <a href="/Login" class="btn btn-primary">Giriş Yap</a>
    </div>
}
else
{
    <div class="text-muted text-center mb-4" style="font-size: 0.9rem;">
        Lütfen yeni şifrenizi belirleyiniz.
    </div>

    <form asp-controller="Login" asp-action="ResetPassword" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label class="form-label" asp-for="Password">Yeni Şifre</label>
            <div class="input-group">
                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                <button class="btn btn-toggle-password" type="button">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label class="form-label" asp-for="PasswordConfirm">Yeni Şifre (Tekrar)</label>
            <div class="input-group">
                <input asp-for="PasswordConfirm" type="password" class="form-control" placeholder="••••••••" />
                <button class="btn btn-toggle-password" type="button">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            <span asp-validation-for="PasswordConfirm" class="text-danger small"></span>
        </div>

        <button class="btn btn-primary w-100 mb-3" type="submit">Şifreyi Güncelle</button>

        <div class="auth-footer">
            <a href="/Login">Giriş sayfasına dön</a>
        </div>
    </form>
}
