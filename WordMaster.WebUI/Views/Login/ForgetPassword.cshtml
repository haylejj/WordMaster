@using WordMaster.Application.ViewModels.Auth
@model ForgetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Şifremi Unuttum";
}

@if (TempData["success"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @TempData["success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="text-muted text-center mb-4" style="font-size: 0.9rem;">
    Lütfen hesabınıza kayıtlı email adresinizi giriniz. Şifre sıfırlama bağlantısı email adresinize gönderilecektir.
</div>

<form asp-controller="Login" asp-action="ForgetPassword" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="mb-4">
        <label class="form-label" asp-for="Email">Email Adresi</label>
        <input asp-for="Email" type="email" class="form-control" placeholder="ornek@email.com" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <button class="btn btn-primary w-100 mb-3" type="submit">Sıfırlama Linki Gönder</button>

    <div class="auth-footer">
        <a href="/Login"><i class="fas fa-arrow-left me-1"></i> Giriş sayfasına dön</a>
    </div>
</form>
