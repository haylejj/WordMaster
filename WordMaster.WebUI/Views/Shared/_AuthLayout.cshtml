<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WordMaster</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        :root {
            --primary-yellow: #FFD700;
            --primary-dark: #121212;
            --primary-gray: #2C2C2C;
            --text-light: #FFFFFF;
            --text-dark: #121212;
        }

        body {
            background-color: #121212;
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: var(--text-dark);
            position: relative;
            overflow: hidden;
            /* Hide scrollbars from background animation */
        }

        /* Animated Background */
        .background-animation {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            overflow: hidden;
        }

        .cube {
            position: absolute;
            top: 80vh;
            left: 45vw;
            width: 10px;
            height: 10px;
            border: solid 1px rgba(255, 215, 0, 0.3);
            /* Yellow border */
            background-color: rgba(255, 215, 0, 0.05);
            /* Faint yellow fill */
            transform-origin: top left;
            transform: scale(0) rotate(0deg) translate(-50%, -50%);
            animation: cube 12s ease-in forwards infinite;
        }

        .cube:nth-child(2n) {
            border-color: rgba(255, 255, 255, 0.2);
            /* White border alt */
            background-color: rgba(255, 255, 255, 0.05);
        }

        .cube:nth-child(1) {
            animation-delay: 2s;
            left: 25vw;
            top: 40vh;
        }

        .cube:nth-child(2) {
            animation-delay: 4s;
            left: 75vw;
            top: 50vh;
        }

        .cube:nth-child(3) {
            animation-delay: 6s;
            left: 90vw;
            top: 10vh;
        }

        .cube:nth-child(4) {
            animation-delay: 8s;
            left: 10vw;
            top: 85vh;
        }

        .cube:nth-child(5) {
            animation-delay: 10s;
            left: 50vw;
            top: 10vh;
        }

        .cube:nth-child(6) {
            animation-delay: 12s;
            left: 80vw;
            top: 70vh;
            /* Adjusted position */
        }

        @@keyframes cube
        {
                from {
                    transform: scale(0) rotate(0deg) translate(-50%, -50%);
                    opacity: 1;
                }

                to {
                    transform: scale(20) rotate(960deg) translate(-50%, -50%);
                    opacity: 0;
                }
            }

            .auth-card {
                background: #ffffff;
                border-radius: 15px;
                box-shadow: 0 0 40px rgba(255, 215, 0, 0.15);
                overflow: hidden;
                width: 100%;
                max-width: 450px;
                border: 1px solid rgba(255, 255, 255, 0.1);
                margin: 20px;
                position: relative;
                z-index: 1;
            }

            .auth-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 5px;
                background: var(--primary-yellow);
            }

            .auth-header {
                background-color: #fff;
                padding: 2.5rem 2rem 1.5rem;
                text-align: center;
            }

            .auth-header h2 {
                color: var(--text-dark);
                font-weight: 700;
                margin: 0;
                letter-spacing: 1px;
            }

            .auth-body {
                padding: 0 2rem 2.5rem;
            }

            .form-control {
                background-color: #f8f9fa;
                border: 2px solid #e9ecef;
                padding: 0.75rem 1rem;
                height: auto;
                font-size: 0.95rem;
                border-radius: 8px;
                color: var(--text-dark);
                transition: all 0.3s ease;
            }

            /* Password input group fix */
            .input-group .form-control {
                border-right: none;
            }

            .input-group .btn-toggle-password {
                background-color: #f8f9fa;
                border: 2px solid #e9ecef;
                border-left: none;
                color: #6c757d;
                border-radius: 0 8px 8px 0;
                transition: all 0.3s ease;
            }

            .input-group .btn-toggle-password:hover {
                background-color: #e9ecef;
                color: var(--primary-dark);
            }

            .form-control:focus {
                background-color: #fff;
                border-color: var(--primary-yellow);
                box-shadow: none;
                /* Remove default shadow, handled by border */
                outline: none;
            }

            .form-control:focus+.btn-toggle-password {
                border-color: var(--primary-yellow);
                background-color: #fff;
            }

            .form-label {
                font-weight: 600;
                color: var(--primary-dark);
                font-size: 0.9rem;
                margin-bottom: 0.5rem;
            }

            .btn-primary {
                background-color: var(--primary-yellow);
                border: none;
                color: var(--primary-dark);
                padding: 0.8rem;
                font-weight: 700;
                letter-spacing: 0.5px;
                transition: all 0.3s ease;
                border-radius: 8px;
                width: 100%;
                text-transform: uppercase;
                font-size: 0.9rem;
            }

            .btn-primary:hover {
                background-color: #FFC107;
                color: #000;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(255, 215, 0, 0.4);
            }

            .btn-primary:active {
                transform: translateY(0);
            }

            .auth-footer {
                text-align: center;
                margin-top: 1.5rem;
                font-size: 0.9rem;
                color: #666;
                border-top: 1px solid #eee;
                padding-top: 1.5rem;
            }

            .auth-footer a {
                color: var(--primary-dark);
                text-decoration: none;
                font-weight: 700;
                border-bottom: 2px solid var(--primary-yellow);
                padding-bottom: 1px;
                transition: all 0.2s;
            }

            .auth-footer a:hover {
                background-color: var(--primary-yellow);
                color: var(--primary-dark);
                text-decoration: none;
                border-bottom-color: transparent;
            }

            .brand-logo {
                font-size: 2.5rem;
                color: var(--primary-dark);
                font-weight: 900;
                margin-bottom: 0.5rem;
                display: inline-block;
                text-transform: uppercase;
                letter-spacing: -1px;
            }

            .brand-logo span {
                color: var(--primary-yellow);
            }

            .page-title {
                font-size: 1.1rem;
                color: #6c757d;
                margin-bottom: 0;
                font-weight: 500;
                text-transform: uppercase;
                letter-spacing: 1px;
            }

            .text-muted {
                color: #888 !important;
            }

            a {
                color: var(--primary-dark);
                text-decoration: none;
                transition: color 0.3s;
            }

            a:hover {
                color: #555;
            }
        </style>
    </head>

    <body>
        <div class="background-animation">
            <div class="cube"></div>
            <div class="cube"></div>
            <div class="cube"></div>
            <div class="cube"></div>
            <div class="cube"></div>
            <div class="cube"></div>
        </div>

        <div class="auth-card">
            <div class="auth-header">
                <div class="brand-logo">Word<span>Master</span></div>
                <h1 class="page-title">@ViewData["Title"]</h1>
            </div>
            <div class="auth-body">
                @RenderBody()
            </div>
        </div>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            $(document).ready(function () {
                // Override inline styles for links to match theme
                $('a[style*="color: #667eea"]').css('color', '#000').css('font-weight', '600');

                // Password Toggle Functionality
                $('.btn-toggle-password').click(function () {
                    const input = $(this).parent().find('input');
                    const icon = $(this).find('i');

                    if (input.attr('type') === 'password') {
                        input.attr('type', 'text');
                        icon.removeClass('fa-eye').addClass('fa-eye-slash');
                    } else {
                        input.attr('type', 'password');
                        icon.removeClass('fa-eye-slash').addClass('fa-eye');
                    }
                });
            });
        </script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>

    </html>