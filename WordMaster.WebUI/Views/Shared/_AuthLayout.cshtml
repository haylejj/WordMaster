<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WordMaster</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/auth-layout.css" asp-append-version="true" />
</head>

<body>
    <div class="background-animation" id="backgroundAnimation">
        <!-- Items will be injected via JS -->
    </div>

    <div class="auth-card">
        <div class="auth-header">
            <div class="brand-logo">Word<span>Master</span></div>
            <h1 class="page-title">@ViewData["Title"]</h1>
        </div>
        <div class="auth-body">
            @RenderBody()
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function () {
            // Override inline styles for links to match theme
            $('a[style*="color: #667eea"]').css('color', '#000').css('font-weight', '600');

            // Password Toggle Functionality
            $('.btn-toggle-password').click(function () {
                const input = $(this).parent().find('input');
                const icon = $(this).find('i');

                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('fa-eye-slash').addClass('fa-eye');
                }
            });

            // Falling Words Animation Logic
            const words = ["Word", "Master", "English", "Learn", "Speak", "Hello", "Book", "Pen", "Study", "Read", "Write", "Listen", "A", "Z", "Vocabulary", "Grammar"];
            const container = document.getElementById('backgroundAnimation');
            const itemCount = 25; // Number of falling items

            for (let i = 0; i < itemCount; i++) {
                createFallingItem();
            }

            function createFallingItem() {
                const item = document.createElement('div');
                item.classList.add('falling-item');

                // Randomly assign yellow class for color variety
                if (Math.random() > 0.7) {
                    item.classList.add('yellow');
                }

                item.innerText = words[Math.floor(Math.random() * words.length)];

                // Random positioning and timing
                const left = Math.floor(Math.random() * 100);
                const duration = Math.floor(Math.random() * 10) + 10; // 10-20s
                const delay = Math.floor(Math.random() * 15); // 0-15s
                const fontSize = Math.floor(Math.random() * 20) + 14; // 14-34px
                const opacity = (Math.random() * 0.3) + 0.2; // 0.2 - 0.5 range (increased visibility)

                item.style.left = left + '%';
                item.style.animationDuration = `${duration}s, ${duration / 2}s`; // Fall duration, Rotate duration
                item.style.animationDelay = `-${delay}s, -${delay}s`; // Negative delay to start immediately at random positions
                item.style.fontSize = fontSize + 'px';
                item.style.opacity = opacity;

                container.appendChild(item);
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>