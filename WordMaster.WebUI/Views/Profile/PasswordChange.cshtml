@using WordMaster.Application.Requests.Auth
@{
    ViewData["Title"] = "PasswordChange";
    Layout = "~/Views/Shared/Main_Layout.cshtml";
}

@model ChangePasswordRequest
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial.cshtml")
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
            <div class="card border-0 shadow-lg rounded-3">
                <div class="card-header bg-gradient bg-dark text-white p-4 rounded-top-3">
                    <h4 class="mb-0 text-center fw-bold"><i class="fas fa-key me-2 text-warning"></i>Şifre Değiştir</h4>
                </div>
                <div class="card-body p-4 p-md-5 bg-light bg-opacity-25">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-0"></div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-controller="Profile" asp-action="PasswordChange" method="post">

                        <div class="form-floating mb-3">
                            <input asp-for="PasswordOld" class="form-control rounded-3" type="password"
                                placeholder="Mevcut Şifre" autocomplete="current-password">
                            <label asp-for="PasswordOld"><i class="fas fa-lock-open me-2 text-muted"></i>Mevcut
                                Şifre</label>
                            <span class="text-danger small ps-1" asp-validation-for="PasswordOld"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="PasswordNew" class="form-control rounded-3" type="password"
                                placeholder="Yeni Şifre" autocomplete="new-password">
                            <label asp-for="PasswordNew"><i class="fas fa-lock me-2 text-muted"></i>Yeni Şifre</label>
                            <span class="text-danger small ps-1" asp-validation-for="PasswordNew"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="PasswordConfirm" class="form-control rounded-3" type="password"
                                placeholder="Yeni Şifre (Tekrar)" autocomplete="new-password">
                            <label asp-for="PasswordConfirm"><i class="fas fa-check-double me-2 text-muted"></i>Yeni
                                Şifre (Tekrar)</label>
                            <span class="text-danger small ps-1" asp-validation-for="PasswordConfirm"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit"
                                class="btn btn-warning btn-lg text-dark fw-bold shadow-sm hover-effect">
                                <i class="fas fa-save me-2"></i>Şifreyi Güncelle
                            </button>
                            <a href="/" class="btn btn-outline-secondary btn-sm mt-2">İptal</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-effect:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(255, 193, 7, 0.4) !important;
    }

    .card {
        transition: all 0.3s ease;
    }
</style>
