@using WordMaster.Application.ViewModels.User
@{
    ViewData["Title"] = "UserEdit";
    Layout = "~/Views/Shared/Main_Layout.cshtml";
}

@model UserEditViewModel
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial.cshtml")
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-3">
                <div class="card-header bg-gradient bg-dark text-white p-4 rounded-top-3">
                    <h4 class="mb-0 text-center fw-bold"><i class="fas fa-user-edit me-2 text-warning"></i>Profil
                        Bilgilerini Güncelle</h4>
                </div>
                <div class="card-body p-4 p-md-5 bg-light bg-opacity-25">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                            <div asp-validation-summary="All" class="text-danger mb-0"></div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-controller="Profile" asp-action="UpdateProfile" method="post"
                        enctype="multipart/form-data">

                        <div class="form-floating mb-3">
                            <input asp-for="UserName" class="form-control rounded-3" placeholder="Kullanıcı Adı">
                            <label asp-for="UserName"><i class="fas fa-user me-2 text-muted"></i>Kullanıcı Adı</label>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Email" class="form-control rounded-3" type="email"
                                placeholder="name@example.com">
                            <label asp-for="Email"><i class="fas fa-envelope me-2 text-muted"></i>E-posta</label>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Phone" class="form-control rounded-3" type="tel" placeholder="Telefon">
                            <label asp-for="Phone"><i class="fas fa-phone me-2 text-muted"></i>Telefon</label>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="BirthDate" class="form-control rounded-3" type="date"
                                        placeholder="Doğum Tarihi">
                                    <label asp-for="BirthDate"><i class="fas fa-calendar-alt me-2 text-muted"></i>Doğum
                                        Tarihi</label>
                                </div>
                            </div>
                        </div>

                        <div class="form-floating mb-3">
                            <select class="form-select rounded-3" asp-for="Gender" asp-items="ViewBag.genderList">
                                <option value="">Seçiniz...</option>
                            </select>
                            <label asp-for="Gender"><i class="fas fa-venus-mars me-2 text-muted"></i>Cinsiyet</label>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit"
                                class="btn btn-warning btn-lg text-dark fw-bold shadow-sm hover-effect">
                                <i class="fas fa-save me-2"></i>Değişiklikleri Kaydet
                            </button>
                            <a href="/" class="btn btn-outline-secondary btn-sm mt-2">İptal</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-effect:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(255, 193, 7, 0.4) !important;
    }

    .card {
        transition: all 0.3s ease;
    }
</style>
