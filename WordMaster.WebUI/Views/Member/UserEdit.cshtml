@using WordMaster.Application.ViewModels
@{
    ViewData["Title"] = "UserEdit";
    Layout = "~/Views/Shared/Main_Layout.cshtml";
}

@model UserEditViewModel
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial.cshtml")
}


<div class="row">
    <div class="col-md-8 offset-md-2 col-lg-6 offset-lg-3">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0"><i class="fas fa-user-edit me-2"></i>Profil Bilgilerini Güncelle</h5>
            </div>
            <div class="card-body">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-info" role="alert">
                        @TempData["SuccessMessage"]
                    </div>
                }
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <form asp-controller="Member" asp-action="UserEdit" method="post" enctype="multipart/form-data">
                    @*bu post bir file nesnesi aldýðý için ecntype ý belirmemiz lazm*@

                    <div class="row mb-3">
                        <label class="col-md-4 col-form-label" for="UserName">Kullanýcý Adý</label>
                        <div class="col-md-8">
                            <input asp-for="UserName" class="form-control">
                            <span class="text-danger" asp-validation-for="UserName"></span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-md-4 col-form-label" for="Email">E-posta</label>
                        <div class="col-md-8">
                            <input asp-for="Email" class="form-control" type="email" autocomplete="email">
                            <span class="text-danger" asp-validation-for="Email"></span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-md-4 col-form-label" for="Phone">Telefon</label>
                        <div class="col-md-8">
                            <input asp-for="Phone" class="form-control" type="tel" autocomplete="tel">
                            <span class="text-danger" asp-validation-for="Phone"></span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-md-4 col-form-label" for="BirthDate">Doðum Tarihi</label>
                        <div class="col-md-8">
                            <input asp-for="BirthDate" class="form-control" type="date">
                            <span class="text-danger" asp-validation-for="BirthDate"></span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-md-4 col-form-label" for="City">Þehir</label>
                        <div class="col-md-8">
                            <input asp-for="City" class="form-control">
                            <span class="text-danger" asp-validation-for="City"></span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-md-4 col-form-label" for="Gender">Cinsiyet</label>
                        <div class="col-md-8">
                            <select class="form-control" asp-for="Gender" asp-items="ViewBag.genderList">
                                <option value="">Cinsiyet Seçiniz</option>
                            </select>
                            <span class="text-danger" asp-validation-for="Gender"></span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-md-4 col-form-label" for="Picture">Profil Fotoðrafý</label>
                        <div class="col-md-8">
                            <input asp-for="Picture" type="file" class="form-control" />
                            <span class="text-danger" asp-validation-for="Picture"></span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-8 offset-md-4">
                            <button type="submit" class="btn btn-warning text-dark fw-bold"><i
                                    class="fas fa-save me-2"></i>Güncelle</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
