@using WordMaster.Application.ViewModels.Word
@model WordViewModel
@{
    ViewData["Title"] = "UpdateWord";
    Layout = "~/Views/Shared/Main_Layout.cshtml";
}
<h2 class="text-center form-page-title">Update Word</h2>

@using (Html.BeginForm("UpdateWord", "Word", FormMethod.Post))
{
    <div class="form-page-container">
        <div class="form-page-form-group">
            <label class="label-english">English:</label>
            @Html.TextBoxFor(x => x.EnglishWord, new { @class = "form-control" })
        </div>
        <div class="form-page-form-group">
            <label class="label-turkish">Turkish:</label>
            @Html.TextBoxFor(x => x.TurkishWord, new { @class = "form-control" })
        </div>
        <button class="practice-btn" id="btn1">Save</button>
    </div>
}
