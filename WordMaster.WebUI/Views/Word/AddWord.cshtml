@model WordResponse
@{
    ViewData["Title"] = "Add Word";
    Layout = "~/Views/Shared/Main_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/add-word.css" asp-append-version="true" />

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger shadow-sm">
                    @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                </div>
            }

            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <div class="bg-warning bg-opacity-10 p-3 rounded-circle me-3 text-warning">
                            <i class="fas fa-plus fa-lg"></i>
                        </div>
                        <h4 class="card-title mb-0 fw-bold">Yeni Kelime Ekle</h4>
                    </div>
                    <button type="button" class="btn btn-outline-success btn-sm fw-bold" data-bs-toggle="modal"
                        data-bs-target="#importModal">
                        <i class="fas fa-file-import me-1"></i> Dışardan Aktar
                    </button>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted small mb-4">Tek bir kelime ve anlamını manuel olarak ekleyin veya CSV ile toplu
                        yükleme yapın.</p>
                    @using (Html.BeginForm("AddWord", "Word", FormMethod.Post))
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary">English Word</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i
                                        class="fas fa-language text-muted"></i></span>
                                @Html.TextBoxFor(x => x.EnglishWord, new { @class = "form-control border-start-0 ps-0",
                                required = "required", maxlength = "30", placeholder = "Apple" })
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold text-secondary">Turkish Meaning</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i
                                    class="fas fa-align-left text-muted"></i></span>
                            @Html.TextBoxFor(x => x.TurkishWord, new { @class = "form-control border-start-0 ps-0",
                                                        required = "required", maxlength = "60", placeholder = "Elma" })
                        </div>
                    </div>
                    <div class="d-grid">
                        <button class="btn btn-warning fw-bold py-2 shadow-sm" type="submit">
                            <i class="fas fa-save me-2"></i>Kaydet
                        </button>
                    </div>
                                        }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Import CSV Modal -->
<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="importModalLabel">
                    <i class="fas fa-file-csv text-success me-2"></i>CSV İle İçe Aktar
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <p class="text-muted small mb-0">Toplu kelime eklemek için CSV dosyası yükleyin.</p>
                    <div>
                        <button type="button" class="btn btn-link text-muted p-0 me-2" data-bs-toggle="modal"
                            data-bs-target="#infoModal" title="Bilgi">
                            <i class="fas fa-question-circle fa-lg"></i>
                        </button>
                        <a href="~/files/sample_words.csv" class="btn btn-outline-primary btn-sm" download>
                            <i class="fas fa-download me-1"></i> Örnek CSV
                        </a>
                    </div>
                </div>

                <form id="csvUploadForm" enctype="multipart/form-data">
                    <div class="mb-4">
                        <label for="csvFile" class="form-label fw-bold text-secondary">Dosya Seçin</label>
                        <div class="upload-area p-4 border border-2 border-dashed rounded-3 text-center bg-light"
                            id="dropZone">
                            <i class="fas fa-cloud-upload-alt fa-3x text-muted mb-3"></i>
                            <p class="mb-2 text-muted">Dosyayı buraya sürükleyin veya seçin</p>
                            <input class="form-control d-none" type="file" id="csvFile" accept=".csv">
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                onclick="document.getElementById('csvFile').click()">Dosya Seç</button>
                            <div id="fileName" class="mt-2 text-success fw-bold small"></div>
                            <div id="fileError" class="mt-2 text-danger fw-bold small"></div>
                        </div>
                        <div class="form-text mt-2">
                            <i class="fas fa-info-circle me-1"></i> Sadece <strong>.csv</strong> dosyaları. Maksimum
                            <strong>10MB</strong>.
                        </div>
                    </div>

                    <div class="d-grid">
                        <button class="btn btn-success fw-bold py-2 shadow-sm" type="button" id="btnImport" disabled>
                            <i class="fas fa-file-import me-2"></i>İçe Aktar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Info Modal -->
<div class="modal fade" id="infoModal" tabindex="-1" aria-labelledby="infoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="infoModalLabel">
                    <i class="fas fa-info-circle text-info me-2"></i>CSV Formatı Hakkında
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted">CSV dosyanızın aşağıdaki kurallara uyması gerekmektedir:</p>
                <ul class="list-group list-group-flush mb-3">
                    <li class="list-group-item px-0">
                        <i class="fas fa-check text-success me-2"></i>Dosya uzantısı <strong>.csv</strong> olmalıdır.
                    </li>
                    <li class="list-group-item px-0">
                        <i class="fas fa-check text-success me-2"></i>Başlık satırı (header) bulunmalıdır:
                        <strong>WORD,MEANING</strong>
                    </li>
                    <li class="list-group-item px-0">
                        <i class="fas fa-check text-success me-2"></i>Sütunlar <strong>virgül (,)</strong> ile
                        ayrılmalıdır.Eğer birden fazla anlam eklemek isterseniz, anlamları boşluk ile ayırabilirsiniz.
                    </li>
                    <li class="list-group-item px-0">
                        <i class="fas fa-check text-success me-2"></i>Türkçe karakter desteği için dosya kodlaması
                        <strong>UTF-8</strong> olmalıdır.
                    </li>
                </ul>
                <div class="alert alert-light border">
                    <strong>Örnek İçerik:</strong><br>
                    <code>WORD,MEANING<br>Apple,Elma<br>Book,Kitap Defter 3.Anlam</code>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button class="btn btn-primary btn-sm" data-bs-target="#importModal" data-bs-toggle="modal">
                    <i class="fas fa-arrow-left me-1"></i> Geri Dön
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/word/add-word.js" asp-append-version="true"></script>
}
