@model PracticeResponse
@{
    Layout = "~/Views/Shared/Main_Layout.cshtml";
    ViewData["Title"] = "Favorilerle Pratik";
    var initialWord = Model?.EnglishWord ?? string.Empty;
    var displayWord = string.IsNullOrWhiteSpace(initialWord) ? "..." : initialWord;
    var hasError = !string.IsNullOrWhiteSpace(Model?.ErrorMessage);
}

<link rel="stylesheet" href="~/css/practice-folder.css" asp-append-version="true" />

<div class="practice-folder-wrapper" data-practice-root
    data-get-word-url="@Url.Action("GetNewEnglishWord", "PracticeFavorite")"
    data-check-url="@Url.Action("CheckTranslation", "PracticeFavorite")">
    <div class="card shadow-sm">
        <div class="card-header">
            <h2 class="mb-0">Favorilerle Pratik</h2>
        </div>
        <div class="card-body">
            <div class="text-center mb-4">
                <span class="text-muted d-block mb-2">İngilizce Kelime</span>
                <h3 id="practiceEnglishWord" class="fw-semibold display-6 fs-2">@displayWord</h3>
                <input type="hidden" id="practiceEnglishWordValue" value="@initialWord" />
            </div>
            <div class="mb-3">
                <label for="practiceTurkishInput" class="form-label">Türkçe Karşılık</label>
                <input type="text" id="practiceTurkishInput" class="form-control form-control-lg"
                    placeholder="Cevabınızı yazın" autocomplete="off" />
            </div>
            <div id="practiceStatus" class="alert d-none mt-3" role="alert">
                <strong id="practiceStatusTitle"></strong>
                <span id="practiceStatusMessage" class="ms-1"></span>
            </div>
            <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
                <button type="button" id="practiceCheckButton" class="btn btn-primary btn-lg px-4">Cevabı Kontrol
                    Et</button>
                <button type="button" id="practiceDontKnowButton"
                    class="btn btn-outline-secondary btn-lg px-4">Bilmiyorum</button>
            </div>
        </div>
    </div>

    @if (hasError)
    {
        <div class="alert alert-warning mt-4 mb-0 text-center">@Model!.ErrorMessage</div>
    }
</div>

@section Scripts {
    <script src="~/js/practice/index.js" asp-append-version="true"></script>
}
