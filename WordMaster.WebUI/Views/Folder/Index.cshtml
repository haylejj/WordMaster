@model IEnumerable<Folder>
@{
    ViewData["Title"] = "Folders";
    Layout = "~/Views/Shared/Main_Layout.cshtml";
}

<h1 class="page-title text-center">Klasörlerim</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-end mb-4">
    <form method="post" asp-controller="Folder" asp-action="Add" class="folder-add-section d-flex align-items-center">
        @Html.AntiForgeryToken()
        <input type="text" name="name" class="folder-add-input" placeholder="Yeni klasör adı" maxlength="60" required />
        <button type="submit" class="btn btn-primary folder-add-btn">Ekle</button>
    </form>
</div>

@if (Model == null || !Model.Any())
{
    <div class="text-center text-muted mt-4">Henüz klasör yok.</div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
        @foreach (var folder in Model)
        {
            <div class="col">
                <div class="card h-100 folder-card position-relative">
                    <div class="position-absolute top-0 end-0 p-2 folder-actions" style="z-index: 10;">
                        <button type="button" class="btn btn-sm btn-warning me-1 rounded-circle shadow-sm" title="Güncelle"
                            onclick="openUpdateModal(@folder.Id, event)"
                            style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-danger rounded-circle shadow-sm" title="Sil"
                            onclick="deleteFolder(@folder.Id, event)"
                            style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                    <a class="text-decoration-none text-reset h-100"
                        href="@Url.Action("Detail", "Folder", new { id = folder.Id })">
                        <div class="card-body d-flex flex-column justify-content-center text-center">
                            <div class="mb-3 text-primary">
                                <i class="fas fa-folder fa-3x"></i>
                            </div>
                            <h5 class="card-title text-truncate w-100">@folder.Name</h5>
                            <div class="folder-meta mt-2">
                                <i class="far fa-clock me-1"></i> @folder.CreatedTime.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        }
    </div>
}

<!-- Update Modal -->
<div class="modal fade" id="updateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-edit"></i> Klasör Güncelle
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="updateFolderForm">
                    <input type="hidden" id="updateFolderId" />
                    <div class="modal-form-group">
                        <label for="updateFolderName" class="modal-form-label">Klasör Adı</label>
                        <div class="modal-input-group">
                            <i class="fas fa-folder modal-input-icon"></i>
                            <input type="text" class="modal-form-control" id="updateFolderName" maxlength="60" required
                                placeholder="Klasör adını giriniz..." />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-modal-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn-modal-primary" onclick="updateFolder()">
                    <i class="fas fa-save me-2"></i>Güncelle
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/folder/index.js" asp-append-version="true"></script>
}