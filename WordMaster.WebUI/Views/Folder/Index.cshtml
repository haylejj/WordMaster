@model IEnumerable<Folder>
@{
    ViewData["Title"] = "Folders";
    Layout = "~/Views/Shared/Main_Layout.cshtml";
}

<h1 class="page-title">Klasörlerim</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3 gap-2">
    <div></div>
    <form method="post" asp-controller="Folder" asp-action="Add" class="d-flex align-items-center gap-2">
        @Html.AntiForgeryToken()
        <input type="text" name="name" class="form-control" placeholder="Yeni klasör adı" maxlength="60" required
            style="max-width: 240px;" />
        <button type="submit" class="btn btn-primary">Ekle</button>
    </form>
</div>

@if (Model == null || !Model.Any())
{
    <div class="text-center text-muted mt-4">Henüz klasör yok.</div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
        @foreach (var folder in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm position-relative">
                    <div class="position-absolute top-0 end-0 p-2" style="z-index: 10;">
                        <button type="button" class="btn btn-sm btn-warning me-1" title="Güncelle"
                            onclick="openUpdateModal(@folder.Id, event)" style="padding: 2px 6px;">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-danger" title="Sil"
                            onclick="deleteFolder(@folder.Id, event)" style="padding: 2px 6px;">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                    <a class="text-decoration-none text-reset" href="@Url.Action("Detail", "Folder", new { id = folder.Id })">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title mb-2">@folder.Name</h5>
                            <div class="text-muted small mb-3">Oluşturma: @folder.CreatedTime.ToLocalTime().ToString("g")</div>
                            <div class="mt-auto d-flex justify-content-end">
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        }
    </div>
}

<!-- Update Modal -->
<div class="modal fade" id="updateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Klasör Güncelle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="updateFolderForm">
                    <input type="hidden" id="updateFolderId" />
                    <div class="mb-3">
                        <label for="updateFolderName" class="form-label">Klasör Adı</label>
                        <input type="text" class="form-control" id="updateFolderName" maxlength="60" required />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-primary" onclick="updateFolder()">Güncelle</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/folder/index.js" asp-append-version="true"></script>
}
