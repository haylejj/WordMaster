@model FolderDetailViewModel
@{
    ViewData["Title"] = Model.FolderName;
    Layout = "~/Views/Shared/Main_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/folder-detail.css" asp-append-version="true" />

<div class="card shadow-sm mt-3">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3 gap-2">
            <h2 class="mb-0">@Model.FolderName</h2>
            <form method="post" asp-controller="Folder" asp-action="AddWord" class="d-flex align-items-center gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="folderId" value="@Model.FolderId" />
                <select id="selectWord" name="wordId" class="form-select" style="min-width:320px;" required>
                    <option value="">Kelime seçin...</option>
                </select>
                <button type="submit" class="btn btn-primary">Ekle</button>
            </form>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (Model.Words == null || !Model.Words.Any())
        {
            <div class="text-center text-muted mt-4">Bu klasörde henüz kelime yok.</div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
                @foreach (var word in Model.Words)
                {
                    <div class="col">
                        <div class="card h-100 flip-card flash-card" onclick="toggleFlip(this)">
                            <div class="flip-card-inner">
                                <div
                                    class="flip-card-front card-body d-flex flex-column justify-content-center align-items-center">
                                    <div class="card-actions">
                                        <button type="button" class="btn btn-sm btn-warning btn-icon" title="Düzenle"
                                            onclick="openUpdateModal(@word.Id, event)">✏️</button>
                                        <button type="button" class="btn btn-sm btn-danger btn-icon" title="Kaldır"
                                            onclick="removeWordFromFolder(@Model.FolderId, @word.Id, event)">🗑️</button>
                                    </div>
                                    <h5 class="mb-0 text-center">@word.EnglishWord</h5>
                                </div>
                                <div
                                    class="flip-card-back card-body d-flex flex-column justify-content-center align-items-center bg-light">
                                    <h5 class="mb-0 text-center">@word.TurkishWord</h5>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Update Modal (reuses Word update endpoints) -->
<div class="modal fade" id="updateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Kelime Güncelle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="updateWordForm">
                    <input type="hidden" id="updateWordId" name="Id" />
                    <div class="mb-3">
                        <label for="updateEnglishWord" class="form-label">English:</label>
                        <input type="text" class="form-control" id="updateEnglishWord" name="EnglishWord" required
                            maxlength="30" />
                    </div>
                    <div class="mb-3">
                        <label for="updateTurkishWord" class="form-label">Turkish:</label>
                        <input type="text" class="form-control" id="updateTurkishWord" name="TurkishWord" required
                            maxlength="30" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-primary" onclick="updateWord()">Güncelle</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/word/modals.js"></script>
    <script src="~/js/folder/detail.js"></script>
}
