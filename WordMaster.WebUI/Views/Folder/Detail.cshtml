@model FolderDetailViewModel
@{
    ViewData["Title"] = Model.FolderName;
    Layout = "~/Views/Shared/Main_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/folder-detail.css" asp-append-version="true" />

<div class="container mt-4">
    <div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
        <h2 class="folder-title">
            <i class="fas fa-folder-open me-2 text-warning"></i>@Model.FolderName
        </h2>
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <a class="btn-practice text-decoration-none" asp-route="PracticeFolderIndex"
                asp-route-folderId="@Model.FolderId">
                <i class="fas fa-play"></i> Pratik Yap
            </a>
            <form method="post" asp-controller="Folder" asp-action="AddWord" class="d-flex align-items-center gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="folderId" value="@Model.FolderId" />
                <div style="min-width: 300px;">
                    <select id="selectWord" name="wordId" class="form-select" required>
                        <option value="">Kelime seçin...</option>
                    </select>
                </div>
                <button type="submit" class="btn-add-word">
                    <i class="fas fa-plus"></i> Ekle
                </button>
            </form>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0" role="alert"
            style="border-radius: 12px;">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0" role="alert"
            style="border-radius: 12px;">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Words == null || !Model.Words.Any())
    {
        <div class="text-center text-muted mt-5">
            <i class="fas fa-folder-open fa-4x mb-3 text-light"></i>
            <p class="h5">Bu klasörde henüz kelime yok.</p>
            <p class="small">Yukarıdaki alandan yeni kelimeler ekleyebilirsiniz.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var word in Model.Words)
            {
                <div class="col">
                    <div class="flip-card" onclick="toggleFlip(this)">
                        <div class="flip-card-inner">
                            <div class="flip-card-front">
                                <div class="card-actions">
                                    <button type="button" class="btn-card-action btn-card-edit" title="Düzenle"
                                        onclick="openUpdateModal(@word.Id, event)">
                                        <i class="fas fa-pen"></i>
                                    </button>
                                    <button type="button" class="btn-card-action btn-card-delete" title="Kaldır"
                                        onclick="removeWordFromFolder(@Model.FolderId, @word.Id, event)">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                                <h5 class="word-text english">@word.EnglishWord</h5>
                                <div class="mt-3 text-muted small">
                                    <i class="fas fa-undo me-1"></i> Çevir
                                </div>
                            </div>
                            <div class="flip-card-back">
                                <h5 class="word-text turkish">@word.TurkishWord</h5>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@await Html.PartialAsync("_UpdateWordModal")

@section Scripts {
    <script src="~/js/word/modals.js"></script>
    <script src="~/js/folder/detail.js"></script>
}