@using WordMaster.Application.ViewModels.User
@model UserListViewModel
@{
    ViewData["Title"] = "Kullanıcılar";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="~/css/admin-user.css" asp-append-version="true" />

<h1 class="text-center page-title">Kullanıcılar</h1>

<form method="get" asp-area="Admin" asp-controller="User" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-sm-6 col-md-6">
        <label for="search" class="admin-form-label">Ara</label>
        <input type="text" id="search" name="search" value="@Model?.Search" class="admin-form-control"
            placeholder="Kullanıcı adı, email veya ID ara" />
    </div>
    <div class="col-sm-3 col-md-3">
        <label for="pageSize" class="admin-form-label">Sayfa başına</label>
        <select id="pageSize" name="pageSize" class="admin-form-control">
            @if (Model?.PageSize == 10)
            {
                <option value="10" selected>10</option>
            }
            else
            {
                <option value="10">10</option>
            }
            @if (Model?.PageSize == 25)
            {
                <option value="25" selected>25</option>
            }
            else
            {
                <option value="25">25</option>
            }
            @if (Model?.PageSize == 50)
            {
                <option value="50" selected>50</option>
            }
            else
            {
                <option value="50">50</option>
            }
            @if (Model?.PageSize == 100)
            {
                <option value="100" selected>100</option>
            }
            else
            {
                <option value="100">100</option>
            }
        </select>
    </div>
    <input type="hidden" name="page" value="1" />
    <div class="col-sm-3 col-md-3">
        <div class="d-flex gap-2">
            <button type="submit" class="btn-admin-primary flex-fill">Uygula</button>
            <a href="@Url.Action("Index", "User", new { area = "Admin" })"
                class="btn-admin-secondary flex-fill text-center text-decoration-none">Filtreyi Temizle</a>
        </div>
    </div>
</form>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="admin-table-container">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Kullanıcı Adı</th>
                <th>Email</th>
                <th>Roller</th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || Model.Users == null || Model.Users.Count == 0)
            {
                <tr>
                    <td colspan="8" class="text-center">
                        <p class="text-muted mt-3 mb-3">Veri bulunmamaktadır.</p>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Users)
                {
                    <tr>
                        <td>@item.UserName</td>
                        <td>@item.Email</td>
                        <td>
                            @if (item.Roles != null && item.Roles.Any())
                            {
                                @foreach (var role in item.Roles)
                                {
                                    <span class="badge bg-danger me-1">@role</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Rol yok</span>
                            }
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn-admin-action btn-admin-edit"
                                onclick="openDetailModal('@item.Id', event)" title="Detay"><i class="fas fa-eye"></i></button>
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn-admin-action btn-admin-edit"
                                onclick="openUpdateModal('@item.Id', event)" title="Güncelle"><i
                                    class="fas fa-edit"></i></button>
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn-admin-action btn-admin-delete"
                                onclick="deleteUser('@item.Id', event)" title="Sil"><i class="fas fa-trash"></i></button>
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn-admin-action btn-admin-edit"
                                onclick="openUpdateRolesModal('@item.Id', event)" title="Rolleri Güncelle"><i
                                    class="fas fa-user-tag"></i></button>
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn-admin-action btn-admin-secondary"
                                onclick="resetPassword('@item.Id', event)" title="Şifre Sıfırla"><i
                                    class="fas fa-key"></i></button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (Model != null && Model.TotalPages > 1)
{
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
        <div class="text-muted">Toplam @Model.TotalCount kayıt</div>
        <nav class="admin-pagination">
            <ul class="pagination mb-0">
                @{
                    var currentPage = Model.Page <= 0 ? 1 : Model.Page;
                    var totalPages = Model.TotalPages;
                    var prevDisabled = currentPage <= 1 ? "disabled" : "";
                    var nextDisabled = currentPage >= totalPages ? "disabled" : "";
                }
                <li class="page-item @prevDisabled">
                    <a class="page-link"
                        href="@Url.Action("Index", "User", new { area = "Admin", search = Model.Search, page = currentPage - 1, pageSize = Model.PageSize })">&laquo;</a>
                </li>
                @if (Model.TotalPages <= 7)
                {
                    for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        var active = p == currentPage ? "active" : string.Empty;
                        <li class="page-item @active">
                            <a class="page-link"
                                href="@Url.Action("Index", "User", new { area = "Admin", search = Model.Search, page = p, pageSize = Model.PageSize })">@p</a>
                        </li>
                    }
                }
                else
                {
                    var startPage = Math.Max(1, currentPage - 2);
                    var endPage = Math.Min(Model.TotalPages, currentPage + 2);

                    if (startPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link"
                                href="@Url.Action("Index", "User", new { area = "Admin", search = Model.Search, page = 1, pageSize = Model.PageSize })">1</a>
                        </li>
                        if (startPage > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                    }

                    for (int p = startPage; p <= endPage; p++)
                    {
                        var active = p == currentPage ? "active" : string.Empty;
                        <li class="page-item @active">
                            <a class="page-link"
                                href="@Url.Action("Index", "User", new { area = "Admin", search = Model.Search, page = p, pageSize = Model.PageSize })">@p</a>
                        </li>
                    }

                    if (endPage < Model.TotalPages)
                    {
                        if (endPage < Model.TotalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                        <li class="page-item">
                            <a class="page-link"
                                href="@Url.Action("Index", "User", new { area = "Admin", search = Model.Search, page = Model.TotalPages, pageSize = Model.PageSize })">@Model.TotalPages</a>
                        </li>
                    }
                }
                <li class="page-item @nextDisabled">
                    <a class="page-link"
                        href="@Url.Action("Index", "User", new { area = "Admin", search = Model.Search, page = currentPage + 1, pageSize = Model.PageSize })">&raquo;</a>
                </li>
            </ul>
        </nav>
    </div>
}

<!-- Update Modal -->
<div class="modal fade" id="updateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content admin-modal-content">
            <div class="modal-header admin-modal-header">
                <h5 class="modal-title admin-modal-title">Kullanıcı Güncelle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                    aria-label="Close"></button>
            </div>
            <div class="modal-body admin-modal-body">
                <form id="updateUserForm">
                    <input type="hidden" id="updateUserId" name="Id" />
                    <div class="mb-3">
                        <label for="updateUserName" class="admin-form-label">Kullanıcı Adı:</label>
                        <input type="text" class="admin-form-control" id="updateUserName" name="UserName" required />
                    </div>
                    <div class="mb-3">
                        <label for="updateEmail" class="admin-form-label">Email:</label>
                        <input type="email" class="admin-form-control" id="updateEmail" name="Email" required />
                    </div>
                    <div class="mb-3">
                        <label for="updatePhone" class="admin-form-label">Telefon:</label>
                        <input type="text" class="admin-form-control" id="updatePhone" name="Phone" />
                    </div>
                    <div class="mb-3">
                        <label for="updateCity" class="admin-form-label">Şehir:</label>
                        <input type="text" class="admin-form-control" id="updateCity" name="City" />
                    </div>
                    <div class="mb-3">
                        <label for="updateBirthDate" class="admin-form-label">Doğum Tarihi:</label>
                        <input type="date" class="admin-form-control" id="updateBirthDate" name="BirthDate" />
                    </div>
                    <div class="mb-3">
                        <label for="updateGender" class="admin-form-label">Cinsiyet:</label>
                        <select class="admin-form-control" id="updateGender" name="Gender">
                            <option value="">Seçiniz</option>
                            <option value="0">Erkek</option>
                            <option value="1">Kadın</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer admin-modal-footer">
                <button type="button" class="btn-admin-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn-admin-primary" onclick="updateUser()">Güncelle</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/user/update.js"></script>
    <script src="~/js/admin/user/delete.js"></script>
    <script src="~/js/admin/user/detail.js"></script>
    <script src="~/js/admin/user/updateRoles.js"></script>
    <script src="~/js/admin/user/resetPassword.js"></script>
}

<!-- Detail Modal -->
<div class="modal fade" id="detailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content admin-modal-content">
            <div class="modal-header admin-modal-header">
                <h5 class="modal-title admin-modal-title">Kullanıcı Detayları</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                    aria-label="Close"></button>
            </div>
            <div class="modal-body admin-modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <h6 class="fw-bold mb-3 text-danger">Kişisel Bilgiler</h6>
                        <table class="table table-borderless text-white">
                            <tr>
                                <td class="fw-bold" style="width: 40%;">ID:</td>
                                <td id="detailId">-</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Kullanıcı Adı:</td>
                                <td id="detailUserName">-</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Email:</td>
                                <td id="detailEmail">-</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Telefon:</td>
                                <td id="detailPhone">-</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Doğum Tarihi:</td>
                                <td id="detailBirthDate">-</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Şehir:</td>
                                <td id="detailCity">-</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Cinsiyet:</td>
                                <td id="detailGender">-</td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-bold mb-3 text-danger">Giriş İstatistikleri</h6>
                        <table class="table table-borderless text-white">
                            <tr>
                                <td class="fw-bold" style="width: 50%;">Toplam Giriş:</td>
                                <td id="detailTotalLoginAttempts">-</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Başarılı Giriş:</td>
                                <td id="detailSuccessfulLogins">-</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Başarısız Giriş:</td>
                                <td id="detailFailedLogins">-</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Son Giriş Tarihi:</td>
                                <td id="detailLastLoginDate">-</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Son Giriş IP Adresi:</td>
                                <td id="detailLastLoginIpAddress">-</td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-12">
                        <h6 class="fw-bold mb-3 text-danger">Kelime İstatistikleri</h6>
                        <table class="table table-borderless text-white">
                            <tr>
                                <td class="fw-bold" style="width: 30%;">Toplam Kelime:</td>
                                <td id="detailWordCount">-</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Favori Sayısı:</td>
                                <td id="detailFavoriteCount">-</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Bilinmeyen Sayısı:</td>
                                <td id="detailUnknowsCount">-</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Son Pratik Tarihi:</td>
                                <td id="detailLastPracticeDate">-</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer admin-modal-footer">
                <button type="button" class="btn-admin-secondary" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<!-- Update Roles Modal -->
<div class="modal fade" id="updateRolesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content admin-modal-content">
            <div class="modal-header admin-modal-header">
                <h5 class="modal-title admin-modal-title">Rolleri Güncelle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                    aria-label="Close"></button>
            </div>
            <div class="modal-body admin-modal-body">
                <form id="updateRolesForm">
                    <input type="hidden" id="updateRolesUserId" name="UserId" />
                    <div class="mb-3">
                        <label class="admin-form-label">Roller:</label>
                        <div id="rolesContainer" class="border rounded p-3 border-secondary"
                            style="max-height: 300px; overflow-y: auto;">
                            <!-- Roller buraya yüklenecek -->
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer admin-modal-footer">
                <button type="button" class="btn-admin-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn-admin-primary" onclick="updateUserRoles()">Güncelle</button>
            </div>
        </div>
    </div>
</div>