@using WordMaster.Application.ViewModels.AllowedIpAddress
@model AllowedIpAddressListViewModel
@{
    ViewData["Title"] = "İzin Verilen IP Adresleri";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="~/css/admin-allowedipaddress.css" asp-append-version="true" />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="mb-3">
    <button type="button" class="btn-admin-primary" onclick="openCreateModal()">Yeni IP Adresi Ekle</button>
</div>

@section Scripts {
    <script src="~/js/admin/allowedipaddress/create.js"></script>
    <script src="~/js/admin/allowedipaddress/update.js"></script>
    <script src="~/js/admin/allowedipaddress/delete.js"></script>
}

<div class="admin-table-container">
    <table class="admin-table">
        <thead>
            <tr>
                <th>IP Adresi</th>
                <th>Açıklama</th>
                <th>Durum</th>
                <th>Oluşturulma Tarihi</th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || Model.AllowedIpAddresses == null || Model.AllowedIpAddresses.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center">
                        <p class="text-muted mt-3 mb-3">Veri bulunmamaktadır.</p>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.AllowedIpAddresses)
                {
                    <tr>
                        <td>@item.IpAddress</td>
                        <td>@(item.Description ?? "-")</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Pasif</span>
                            }
                        </td>
                        <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="text-center">
                            <button type="button" class="btn-admin-action btn-admin-edit"
                                onclick="openUpdateModal(@item.Id, event)" title="Güncelle"><i class="fas fa-edit"></i></button>
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn-admin-action btn-admin-delete"
                                onclick="deleteAllowedIpAddress(@item.Id, event)" title="Sil"><i
                                    class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content admin-modal-content">
            <div class="modal-header admin-modal-header">
                <h5 class="modal-title admin-modal-title">Yeni IP Adresi Ekle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                    aria-label="Close"></button>
            </div>
            <div class="modal-body admin-modal-body">
                <form id="createAllowedIpAddressForm">
                    <div class="mb-3">
                        <label for="createIpAddress" class="admin-form-label">IP Adresi: <span
                                class="text-danger">*</span></label>
                        <input type="text" class="admin-form-control" id="createIpAddress" name="IpAddress"
                            placeholder="192.168.1.1 veya IPv6 formatı" required />
                        <small class="form-text text-muted">IPv4 veya IPv6 formatında geçerli bir IP adresi
                            giriniz.</small>
                    </div>
                    <div class="mb-3">
                        <label for="createDescription" class="admin-form-label">Açıklama:</label>
                        <textarea class="admin-form-control" id="createDescription" name="Description" rows="3"
                            placeholder="Opsiyonel açıklama"></textarea>
                    </div>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="createIsActive" name="IsActive" checked>
                            <label class="form-check-label text-white" for="createIsActive">
                                Aktif
                            </label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer admin-modal-footer">
                <button type="button" class="btn-admin-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn-admin-primary" onclick="createAllowedIpAddress()">Oluştur</button>
            </div>
        </div>
    </div>
</div>

<!-- Update Modal -->
<div class="modal fade" id="updateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content admin-modal-content">
            <div class="modal-header admin-modal-header">
                <h5 class="modal-title admin-modal-title">IP Adresi Güncelle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                    aria-label="Close"></button>
            </div>
            <div class="modal-body admin-modal-body">
                <form id="updateAllowedIpAddressForm">
                    <input type="hidden" id="updateAllowedIpAddressId" name="Id" />
                    <div class="mb-3">
                        <label for="updateIpAddress" class="admin-form-label">IP Adresi: <span
                                class="text-danger">*</span></label>
                        <input type="text" class="admin-form-control" id="updateIpAddress" name="IpAddress"
                            placeholder="192.168.1.1 veya IPv6 formatı" required />
                        <small class="form-text text-muted">IPv4 veya IPv6 formatında geçerli bir IP adresi
                            giriniz.</small>
                    </div>
                    <div class="mb-3">
                        <label for="updateDescription" class="admin-form-label">Açıklama:</label>
                        <textarea class="admin-form-control" id="updateDescription" name="Description" rows="3"
                            placeholder="Opsiyonel açıklama"></textarea>
                    </div>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="updateIsActive" name="IsActive">
                            <label class="form-check-label text-white" for="updateIsActive">
                                Aktif
                            </label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer admin-modal-footer">
                <button type="button" class="btn-admin-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn-admin-primary" onclick="updateAllowedIpAddress()">Güncelle</button>
            </div>
        </div>
    </div>
</div>