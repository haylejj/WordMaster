@model Core.Dto.WordDto
@{
    ViewData["Title"] = "AddWord";
    Layout = "~/Views/Shared/Main_Layout.cshtml";
}
<script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
<script src="\lib\jquery\dist\jquery.js"></script>

<h2 class="text-center form-page-title">Add Word to Your Dictionary</h2>
@using (Html.BeginForm("AddWord", "Word", FormMethod.Post))
{
    <div class="form-page-container">
        <div class="form-page-form-group">
            <label class="label-english">English:</label>
            @Html.TextBoxFor(x => x.EnglishWord, new { @class = "form-control" })
        </div>
        <div class="form-page-form-group">
            <label class="label-turkish">Turkish:</label>
            @Html.TextBoxFor(x => x.TurkishWord, new { @class = "form-control" })
        </div>
        <button class="practice-btn" id="btn1">Save</button>
    </div>
}
<script>
    $('#btn1').click(function (event) {
        event.preventDefault(); // Formun otomatik submit olmasını engeller

        swal({
            title: "Başarılı",
            text: "Kelime başarıyla eklendi!",
            icon: "success",
            button: "Tamam",
        }).then(function () {
            $('form').submit(); // Formun submit işlemini gerçekleştirir
        });
    });
</script>
