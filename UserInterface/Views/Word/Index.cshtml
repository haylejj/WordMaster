@using Core.Entity
@model List<Word>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/Main_Layout.cshtml";
}
<script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/word/delete.js"></script>
<script src="~/js/word/update.js"></script>
<script src="~/js/word/toggle.js"></script>

<h1 class="text-center page-title">Kelimelerim</h1>
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<table class="table table-bordered table-striped table-hover">
    <thead>
        <tr>
            <th>İngilizce</th>
            <th>Türkçe</th>
            <th>İşlemler</th>
            <th>Güncelle</th>
            <th>Sil</th>
        </tr>
    </thead>
    <tbody>
        @if (Model == null || Model.Count == 0)
        {
            <tr>
                <td colspan="5" class="text-center">
                    <p class="text-muted mt-3 mb-3">Veri bulunmamaktadır.</p>
                </td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.EnglishWord</td>
                    <td>@item.TurkishWord</td>
                    <td class="text-center">
                        <div class="d-flex flex-column gap-2 align-items-center">
                            <div class="form-check form-switch">
                                <input class="form-check-input favorite-checkbox" type="checkbox" data-word-id="@item.Id"
                                    @(item.Favorite != null ? "checked" : "") id="favorite-@item.Id">
                                <label class="form-check-label" for="favorite-@item.Id">Favorites</label>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input unknows-checkbox" type="checkbox" data-word-id="@item.Id"
                                    @(item.Unknows != null ? "checked" : "") id="unknows-@item.Id">
                                <label class="form-check-label" for="unknows-@item.Id">Unknows</label>
                            </div>
                        </div>
                    </td>
                    <td>
                        <a href="#" class="btn btn-warning" onclick="openUpdateModal(@item.Id, event)">Update</a>
                    </td>
                    <td>
                        <a href="#" class="btn btn-danger" onclick="deleteWord(@item.Id, event)">Delete</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<!-- Update Modal -->
<div class="modal fade" id="updateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Kelime Güncelle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="updateWordForm">
                    <input type="hidden" id="updateWordId" name="Id" />
                    <div class="mb-3">
                        <label for="updateEnglishWord" class="form-label">English:</label>
                        <input type="text" class="form-control" id="updateEnglishWord" name="EnglishWord" required
                            maxlength="30" />
                    </div>
                    <div class="mb-3">
                        <label for="updateTurkishWord" class="form-label">Turkish:</label>
                        <input type="text" class="form-control" id="updateTurkishWord" name="TurkishWord" required
                            maxlength="30" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-primary" onclick="updateWord()">Güncelle</button>
            </div>
        </div>
    </div>
</div>